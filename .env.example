# Fournisseur IA par défaut : native | anthropic | openai
AI_PROVIDER=native
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=30000
FILE_SYNC_ENABLED=true
ALLOW_CLIENT_KEYS=false

# Optionnel : emplacement et limites du fichier de sauvegarde local
# STORAGE_DIR=./data
# STORAGE_MAX_BYTES=52428800
# STORAGE_BACKUP_INTERVAL_MS=300000

# Optionnel : Atelier Français, couche 2 (LanguageTool auto-hébergé)
# docker run -d -p 8010:8010 erikvl87/languagetool
# LANGUAGETOOL_URL=http://localhost:8010
